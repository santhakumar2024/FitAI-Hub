generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String               @id @default(cuid())
  name                String
  email               String               @unique
  password            String
  phone               String?              @unique
  role                Role                 @default(NORMAL_USER)
  isFreelance         Boolean              @default(false)
  gender              Gender?
  age                 Int?
  height              Float?
  weight              Float?
  bmi                 Float?
  photoUrl            String?
  medicalConditions   Json                 @default("[]")
  goals               Json                 @default("[]")
  activityLevel       ActivityLevel        @default(moderately_active)
  preferences         Json                 @default("[]")
  isEmailVerified     Boolean              @default(false)
  isActive            Boolean              @default(true)
  fcmToken            String?
  lastLoginAt         DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  gymId               String?
  daysPerWeek         Int?
  dislikedExercises   Json                 @default("[]")
  equipmentAccess     Json                 @default("[]")
  experienceLevel     String?
  goalType            String?
  jobNature           String?
  medicalScreening    Json                 @default("{}")
  mobileNumber        String?
  motivationLevel     Int?
  pushupTest          Int?
  recentActivity      Int?
  squatTest           Int?
  targetWeight        Float?
  timePerSession      Int?
  timeline            String?
  trainingStyle       String?
  work                String?
  workoutLocation     String?
  themePreference     String               @default("light")
  aiGenerationLogs    AIGenerationLog[]
  overriddenPlans     AIPlan[]             @relation("PlanEditor")
  aiPlans             AIPlan[]
  clientRelations     ClientTrainer[]      @relation("ClientRelation")
  trainerClients      ClientTrainer[]      @relation("TrainerRelation")
  ownedGyms           Gym[]                @relation("GymOwner")
  notifications       Notification[]
  otpCodes            OTPCode[]
  passwordResetTokens PasswordResetToken[]
  progressLogs        ProgressLog[]
  refreshTokens       RefreshToken[]
  subscriptions       Subscription[]
  gymMemberships      GymMembership[]
  receivedNotes       TrainerNote[]        @relation("TrainerNoteClient")
  trainerNotes        TrainerNote[]        @relation("TrainerNoteAuthor")
  gym                 Gym?                 @relation("GymTrainers", fields: [gymId], references: [id])

  @@index([email])
  @@index([role])
  @@index([gymId])
  @@map("users")
}

model Gym {
  id                String          @id @default(cuid())
  name              String
  address           String?
  city              String?
  state             String?
  pincode           String?
  phone             String?
  email             String?
  logoUrl           String?
  description       String?
  isActive          Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  ownerId           String
  clientAssignments ClientTrainer[]
  owner             User            @relation("GymOwner", fields: [ownerId], references: [id])
  trainers          User[]          @relation("GymTrainers")
  subscription      Subscription?
  membershipPlans   GymMembershipPlan[]
  gymMemberships    GymMembership[]

  @@index([ownerId])
  @@map("gyms")
}

model ClientTrainer {
  id         String   @id @default(cuid())
  clientId   String
  trainerId  String
  gymId      String?
  assignedAt DateTime @default(now())
  isActive   Boolean  @default(true)
  client     User     @relation("ClientRelation", fields: [clientId], references: [id])
  gym        Gym?     @relation(fields: [gymId], references: [id])
  trainer    User     @relation("TrainerRelation", fields: [trainerId], references: [id])

  @@unique([clientId, trainerId])
  @@index([clientId])
  @@index([trainerId])
  @@index([gymId])
  @@map("client_trainers")
}

model Subscription {
  id                     String             @id @default(cuid())
  userId                 String
  gymId                  String?            @unique
  planType               PlanType           @default(FREE_TRIAL)
  status                 SubscriptionStatus @default(trial)
  trialEndsAt            DateTime?
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  razorpayOrderId        String?
  razorpayPaymentId      String?
  razorpaySubscriptionId String?
  amount                 Int?
  currency               String             @default("INR")
  cancelledAt            DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  user                   User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  gym                    Gym?               @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([gymId])
  @@index([status])
  @@map("subscriptions")
}

model GymMembershipPlan {
  id              String           @id @default(cuid())
  gymId           String
  name            String
  price           Float
  durationMonths  Int
  description     String?
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  gym             Gym              @relation(fields: [gymId], references: [id], onDelete: Cascade)
  memberships     GymMembership[]

  @@index([gymId])
  @@map("gym_membership_plans")
}

model GymMembership {
  id                  String             @id @default(cuid())
  userId              String
  gymId               String
  membershipPlanId    String
  startDate           DateTime           @default(now())
  endDate             DateTime?
  status              SubscriptionStatus @default(active)
  paidAmount          Float?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  
  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  gym                 Gym                @relation(fields: [gymId], references: [id], onDelete: Cascade)
  plan                GymMembershipPlan  @relation(fields: [membershipPlanId], references: [id])

  @@index([userId])
  @@index([gymId])
  @@index([membershipPlanId])
  @@map("gym_memberships")
}

model AIPlan {
  id                String    @id @default(cuid())
  userId            String
  version           Int       @default(1)
  durationDays      Int       @default(7)
  generatedPlan     Json
  isManuallyEdited  Boolean   @default(false)
  editedById        String?
  editedAt          DateTime?
  editReason        String?
  isActive          Boolean   @default(true)
  generatedAt       DateTime  @default(now())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  age               Int?
  gender            String?
  height            Float?
  weight            Float?
  bmi               Float?
  activityLevel     String?
  medicalConditions Json      @default("[]")
  goals             Json      @default("[]")
  preferences       Json      @default("[]")
  estimatedCalories Int?
  generalNotes      String?
  editedBy          User?     @relation("PlanEditor", fields: [editedById], references: [id])
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isActive])
  @@index([userId, isActive])
  @@map("ai_plans")
}

model ProgressLog {
  id          String       @id @default(cuid())
  userId      String
  date        DateTime     @db.Date
  weight      Float?
  bmi         Float?
  photoUrl    String?
  notes       String?
  streak      Int          @default(0)
  mood        String?
  energyLevel Int?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  dietLog     DietLog?
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  workoutLogs WorkoutLog[]
  yogaLogs    YogaLog[]

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
  @@map("progress_logs")
}

model DietLog {
  id                String      @id @default(cuid())
  progressLogId     String      @unique
  totalCalories     Int?
  totalProtein      Float?
  totalCarbs        Float?
  totalFat          Float?
  waterIntake       Float?
  createdAt         DateTime    @default(now())
  breakfastCalories Int?
  breakfastProtein  Float?
  dinnerCalories    Int?
  dinnerProtein     Float?
  lunchCalories     Int?
  lunchProtein      Float?
  snackCalories     Int?
  snackProtein      Float?
  breakfast         Json        @default("[]")
  lunch             Json        @default("[]")
  dinner            Json        @default("[]")
  snacks            Json        @default("[]")
  progressLog       ProgressLog @relation(fields: [progressLogId], references: [id], onDelete: Cascade)

  @@index([progressLogId])
  @@map("diet_logs")
}

model WorkoutLog {
  id              String      @id @default(cuid())
  progressLogId   String
  exercise        String
  sets            Int?
  reps            Int?
  durationMinutes Int?
  caloriesBurned  Int?
  isCompleted     Boolean     @default(true)
  notes           String?
  createdAt       DateTime    @default(now())
  progressLog     ProgressLog @relation(fields: [progressLogId], references: [id], onDelete: Cascade)

  @@index([progressLogId])
  @@map("workout_logs")
}

model YogaLog {
  id              String      @id @default(cuid())
  progressLogId   String
  pose            String
  durationMinutes Int?
  isCompleted     Boolean     @default(true)
  notes           String?
  createdAt       DateTime    @default(now())
  progressLog     ProgressLog @relation(fields: [progressLogId], references: [id], onDelete: Cascade)

  @@index([progressLogId])
  @@map("yoga_logs")
}

model TrainerNote {
  id        String   @id @default(cuid())
  trainerId String
  clientId  String
  note      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  client    User     @relation("TrainerNoteClient", fields: [clientId], references: [id])
  trainer   User     @relation("TrainerNoteAuthor", fields: [trainerId], references: [id])

  @@index([trainerId])
  @@index([clientId])
  @@map("trainer_notes")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  data      Json?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  isRevoked Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("password_reset_tokens")
}

model OTPCode {
  id        String   @id @default(cuid())
  userId    String
  code      String
  expiresAt DateTime
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("otp_codes")
}

model AIGenerationLog {
  id           String   @id @default(cuid())
  userId       String
  provider     String
  model        String
  inputTokens  Int?
  outputTokens Int?
  totalTokens  Int?
  latencyMs    Int?
  status       String
  error        String?
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("ai_generation_logs")
}

enum Role {
  NORMAL_USER
  GYM_OWNER
  TRAINER
}

enum Gender {
  male
  female
  other
}

enum SubscriptionStatus {
  trial
  active
  expired
  cancelled
  past_due
}

enum PlanType {
  FREE_TRIAL
  NORMAL_100
  FREELANCER_200
  OWNER_500
}

enum ActivityLevel {
  sedentary
  lightly_active
  moderately_active
  very_active
  extra_active
}

enum LogType {
  diet
  workout
  yoga
  weight
  all
}

enum NotificationType {
  plan_generated
  plan_overridden
  subscription_expiry
  streak_milestone
  trainer_note
  welcome
}
