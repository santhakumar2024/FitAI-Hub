# Bcrypt
BCRYPT_ROUNDS=12

# CORS
CORS_ORIGIN=http://localhost:3000,http://10.16.211.114:8081,http://10.16.211.114:19000,exp://localhost:19000

# OpenAI (GPT-4o)
OPENAI_API_KEY=sk-abcdef1234567890abcdef1234567890abcdef12
